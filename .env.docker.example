# Docker Compose overrides (copy relevant lines to .env or use with compose)
# See DOCKER.md

DOCKER_COMPOSE=1
POSTGRES_HOST=db
POSTGRES_USER=eduspark
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=eduspark
POSTGRES_PUBLISH_PORT=5432

JWT_SECRET=generate-a-long-random-secret-here
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5

ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false
USE_MARKER_PDF=true
PROCESS_MINIMAL_PIPELINE=true

VITE_API_URL=http://127.0.0.1:8000
