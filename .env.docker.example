# Copy to .env when using Docker Compose (optional — compose has defaults)
# Local-only dev without Docker: keep POSTGRES_HOST=localhost in .env

POSTGRES_USER=eduspark
POSTGRES_PASSWORD=eduspark
POSTGRES_DB=eduspark
# Use 5433 if local PostgreSQL already uses 5432
POSTGRES_PUBLISH_PORT=5432

JWT_SECRET=change-me-to-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false

# Browser → Vite on host; Vite proxy → backend container
VITE_API_URL=http://127.0.0.1:8000
