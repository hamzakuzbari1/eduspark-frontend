# =============================================================================
# EduSpark — environment template (copy to .env and fill in real values)
#   cp .env.example .env
# Never commit .env — it is gitignored.
# =============================================================================

# --- PostgreSQL (local; URLs auto-built if DATABASE_URL is empty) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=eduspark

# Optional overrides (leave empty to use POSTGRES_* above)
DATABASE_URL=
DATABASE_URL_SYNC=

# --- API security ---
JWT_SECRET=generate-a-long-random-secret-here

# --- LLM: Ollama (primary for chat / RAG answers) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_TIMEOUT_SECONDS=180

# --- Optional: Gemini (voice persona, quiz, fallback LLM) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# --- App ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=

# --- RAG (keyword retrieval from DB chunks; set RAG_FORCE_TOP_K=0) ---
RAG_TOP_K=3
RAG_MIN_SCORE=0.08
RAG_MAX_CHUNK_CHARS=500
RAG_MAX_CONTEXT_CHARS=1500
RAG_FORCE_TOP_K=0
RAG_DEBUG=false
RAG_LOG_LLM_PROMPT=false
CHUNK_SIZE=800
CHUNK_OVERLAP=120
QUIZ_COUNT=3

# --- pgvector (optional; off on typical local Windows Postgres) ---
ENABLE_PGVECTOR=false
ENABLE_EMBEDDINGS=false

# --- PDF: Marker → markdown → chunking → DB (recommended for scanned/math PDFs) ---
USE_MARKER_PDF=true
MARKER_TIMEOUT_SECONDS=600
MARKER_THREAD_WORKERS=1
MARKER_PERSIST_MD=true
PDF_PROCESS_IN_BACKGROUND=true

# Core-only processing (no embeddings / voice persona / quiz during lesson upload)
# Set false after Marker pipeline is stable to re-enable heavy stages
PROCESS_MINIMAL_PIPELINE=true

# --- Optional local AI (pip install -r backend/requirements-ai.txt) ---
USE_LOCAL_EMBEDDINGS=false
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BUILD_TIMEOUT_SECONDS=300
USE_LOCAL_WHISPER=false
WHISPER_MODEL=turbo
USE_LOCAL_TTS=false
VOICE_TRANSCRIBE_TIMEOUT_SECONDS=120
PERSONA_BUILD_TIMEOUT_SECONDS=90
QUIZ_GENERATION_TIMEOUT_SECONDS=90

# --- Frontend (Vite dev proxy → backend) ---
VITE_API_URL=http://127.0.0.1:8000
# VITE_API_DIRECT=true
# VITE_USE_MOCK=true

# --- Docker Compose (optional; see DOCKER.md) ---
# DOCKER_COMPOSE=1
# POSTGRES_PUBLISH_PORT=5432
